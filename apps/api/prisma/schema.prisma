generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles are data: what a role may do is its list of permission keys, never its name.
model Role {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  permissions  String[]
  // Users with this role appear in "assign to" lists.
  isAssignable Boolean  @default(false)
  // Users with this role appear in "tested by" lists.
  canTest      Boolean  @default(false)
  // Role given to people signing in for the first time.
  isDefault    Boolean  @default(false)
  users        User[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Sign-ups start PENDING until an admin approves them (APPROVED) or declines (REJECTED).
enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String     @id @default(cuid())
  // Display name, kept as "First Last".
  name               String
  firstName          String?
  lastName           String?
  email              String     @unique
  // scrypt hash; null until the person sets a password.
  passwordHash       String?
  // Set when an admin resets the password; the person must choose a new one after signing in.
  mustChangePassword Boolean    @default(false)
  googleId           String?    @unique
  avatarUrl          String?
  status             UserStatus @default(APPROVED)
  // Deactivated users can't sign in. Separate from status so history is kept.
  isActive           Boolean    @default(true)
  roleId             String
  role               Role       @relation(fields: [roleId], references: [id])
  // Per-person adjustments on top of the role's permissions.
  grantedPermissions String[]   @default([])
  revokedPermissions String[]   @default([])
  // Not a real person: the "User" entry in "Tested by" (confirmation from the user's side). It can't sign
  // in, and the testing sign-off never waits for it.
  isPlaceholder      Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  reportedTasks Task[]         @relation("TaskReporter")
  assignedTasks Task[]         @relation("TaskAssignees")
  testedTasks   Task[]         @relation("TaskTesters")
  testVerdicts  TestVerdict[]
  comments      Comment[]
  attachments   Attachment[]   @relation("AttachmentUploader")
  history       TaskHistory[]
  sessions      Session[]
  notifications Notification[] @relation("NotificationRecipient")
  sentNotices   Notification[] @relation("NotificationActor")
}

// Login sessions. The browser holds the raw token in a cookie; only its SHA-256 is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // In-app page to open when there's no task, e.g. "access?tab=requests".
  link        String?
  message     String
  // Set on automatic reminders (e.g. "overdue:<taskId>:<probable date>") so each is sent once.
  reminderKey String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, reminderKey])
  @@index([userId, createdAt])
}

// A Partner Organisation, shown as "PO" in the web app.
model Client {
  id        String   @id @default(cuid())
  name      String   @unique
  // Chip colour in the task sheet.
  color     String   @default("#7c3aed")
  isActive  Boolean  @default(true)
  tasks     Task[]
  createdAt DateTime @default(now())
}

// Feature / Bug / Daily, configurable.
model TaskType {
  id        String  @id @default(cuid())
  name      String  @unique
  color     String
  sortOrder Int     @default(0)
  // Routine work done every day ("Daily"): no probable date, gap days or deadlines.
  isRoutine Boolean @default(false)
  tasks     Task[]
}

model Priority {
  id    String @id @default(cuid())
  name  String @unique
  color String
  // Lower rank = more urgent.
  rank  Int    @default(0)
  tasks Task[]
}

model Status {
  id        String  @id @default(cuid())
  name      String  @unique
  color     String
  sortOrder Int     @default(0)
  // Moving a task into a closed status stamps its delivered date.
  isClosed  Boolean @default(false)
  // Status given to newly created tasks.
  isInitial Boolean @default(false)
  tasks     Task[]

  transitionsFrom StatusTransition[] @relation("TransitionFrom")
  transitionsTo   StatusTransition[] @relation("TransitionTo")
}

// Which status a task may move to from another. A move not listed here is rejected.
model StatusTransition {
  id           String @id @default(cuid())
  fromStatusId String
  toStatusId   String
  fromStatus   Status @relation("TransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus     Status @relation("TransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@unique([fromStatusId, toStatusId])
}

model Task {
  id                   String    @id @default(cuid())
  number               Int       @unique @default(autoincrement())
  title                String
  description          String?
  // A task can concern several POs (e.g. the same fix for two POs).
  clients              Client[]
  // Type and priority may be left blank, as in the team sheet.
  typeId               String?
  type                 TaskType? @relation(fields: [typeId], references: [id])
  priorityId           String?
  priority             Priority? @relation(fields: [priorityId], references: [id])
  statusId             String
  status               Status    @relation(fields: [statusId], references: [id])
  reporterId           String
  reporter             User      @relation("TaskReporter", fields: [reporterId], references: [id])
  // "Assigned dev": one or more people whose role can take tasks (or none = unassigned).
  assignees            User[]    @relation("TaskAssignees")
  // "Tested by": one or more people whose role can test (or none yet).
  testers              User[]    @relation("TaskTesters")
  // Shown as "Date": the day the task was assigned.
  reportedDate         DateTime  @db.Date
  // Shown as "Probable date": the developer's estimate.
  expectedDeliveryDate DateTime? @db.Date
  // Shown as "Completed": stamped when the task reaches a closed status.
  deliveredDate        DateTime? @db.Date
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  comments      Comment[]
  history       TaskHistory[]
  notifications Notification[]
  attachments   Attachment[]
  testVerdicts  TestVerdict[]
  tags          TaskTag[]

  @@index([reporterId])
  @@index([statusId])
}

// A label people put on tasks to find related work later. Anyone editing a task can add a new plain tag
// by typing it; people with "Manage tags" rename, recolour and archive tags, and set what details a tag
// asks for (e.g. "Database/DB" asks for the tables the issue touches).
model Tag {
  id               String    @id @default(cuid())
  // Unique ignoring case (checked by the API).
  name             String    @unique
  color            String    @default("#5f6673")
  // What the details are called, e.g. "Tables", "Form files", "Screens". Null = a plain tag. A tag with
  // details needs at least one on every task it's on.
  detailLabel      String?
  // An example shown in the empty box, e.g. "CR_INFO".
  detailHint       String?
  // Each detail must end in one of these (e.g. fmb, fmx, rdf); empty = any text.
  detailExtensions String[]  @default([])
  // Details are saved in capitals (database table names).
  detailUppercase  Boolean   @default(false)
  // Archived tags stay on their tasks but can't be added to more.
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  tasks            TaskTag[]
}

model TaskTag {
  taskId  String
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  // The tables, file names or screens this task touches (for tags that ask for details).
  details String[] @default([])

  @@id([taskId, tagId])
  @@index([tagId])
}

// A tester's verdict in the current testing round: passed, or sent back with a reason. A task stays in
// Testing until every tester has one. Cleared whenever the task's status changes (other than Testing →
// Completed), so every round starts fresh.
model TestVerdict {
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  testerId  String
  tester    User     @relation(fields: [testerId], references: [id], onDelete: Cascade)
  // true = passed; false = sent back.
  passed    Boolean
  // What still needs fixing (sent back only); also saved as a comment.
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([taskId, testerId])
}

// Evidence files (screenshots, logs, PDFs) kept in the database so they're backed up with the
// tasks and removed with them.
model Attachment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation("AttachmentUploader", fields: [uploaderId], references: [id])
  fileName   String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([taskId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

// One row per changed field, with display values captured at the time of the change.
model TaskHistory {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  field     String
  oldValue  String?
  newValue  String?
  // Ids behind the display values where names can repeat (comma-separated user ids for "Assignee"),
  // so the KPI report credits the right people. Empty on rows written before they were recorded.
  oldRef    String?
  newRef    String?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}
