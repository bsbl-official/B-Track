
DATABASE_URL="postgresql://task_tracker:task_tracker@localhost:5432/task_tracker?schema=public"
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Google sign-in: create an OAuth client ID (type "Web application") in Google Cloud Console
# with http://localhost:5173 as an authorised JavaScript origin, then paste it here.
GOOGLE_CLIENT_ID=
# Comma-separated email domains allowed to sign in, e.g. brainstation-23.com. Empty = any Google account.
ALLOWED_EMAIL_DOMAINS=
# Comma-separated emails that become Admin on first sign-in.
ADMIN_EMAILS=
# Signs short-lived Google sign-up tokens. Use a long random string (required in production).
AUTH_SECRET=
# Local testing only: shows collapsed tools to switch user and simulate Google sign-up.
DEV_LOGIN=true
# Only for `npm run db:copy`: the empty, migrated database to copy local data into (e.g. Neon).
# TARGET_DATABASE_URL=
