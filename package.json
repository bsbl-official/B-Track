{
  "name": "custom-project-task-tracker",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n db,api,web -c gray,blue,green \"npm:db:start\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @task-tracker/api",
    "dev:web": "npm run dev --workspace @task-tracker/web",
    "build": "npm run build --workspace @task-tracker/api && npm run build --workspace @task-tracker/web",
    "typecheck": "npm run typecheck --workspace @task-tracker/api && npm run typecheck --workspace @task-tracker/web",
    "start": "npm run db:deploy --workspace @task-tracker/api && npm run start --workspace @task-tracker/api",
    "db:start": "npm run db:start --workspace @task-tracker/api",
    "db:generate": "npm run db:generate --workspace @task-tracker/api",
    "db:migrate": "npm run db:migrate --workspace @task-tracker/api",
    "db:seed": "npm run db:seed --workspace @task-tracker/api",
    "db:studio": "npm run db:studio --workspace @task-tracker/api"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {}
}
